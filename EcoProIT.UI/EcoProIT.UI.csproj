<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <SccProjectName>SAK</SccProjectName>
    <SccLocalPath>SAK</SccLocalPath>
    <SccAuxPath>SAK</SccAuxPath>
    <SccProvider>SAK</SccProvider>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <InstallUrl>http://ecoproit.codeplex.com/releases/clickonce/</InstallUrl>
    <SupportUrl>http://ecoproit.codeplex.com</SupportUrl>
    <ErrorReportUrl>http://ecoproit.codeplex.com</ErrorReportUrl>
    <TargetCulture>en</TargetCulture>
    <ProductName>EcoProIT Tool</ProductName>
    <PublisherName>Jon Larborn</PublisherName>
    <SuiteName>EcoProIT</SuiteName>
    <CreateWebPageOnPublish>true</CreateWebPageOnPublish>
    <WebPage>ecoproit.htm</WebPage>
    <TrustUrlParameters>true</TrustUrlParameters>
    <ApplicationRevision>8</ApplicationRevision>
    <ApplicationVersion>2.1.0.0</ApplicationVersion>
    <UseApplicationTrust>true</UseApplicationTrust>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <PublishWizardCompleted>true</PublishWizardCompleted>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Configurations>CD_ROM;Debug;DVD-5;Release;SingleImage</Configurations>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ManifestCertificateThumbprint>50BB5F3D44E458EC795EBB599E3AC282E16DC46E</ManifestCertificateThumbprint>
    <ManifestKeyFile />
    <GenerateManifests>false</GenerateManifests>
    <SignManifests>false</SignManifests>
    <AssemblyOriginatorKeyFile />
    <DelaySign>false</DelaySign>
    <ManifestTimestampUrl />
    <StartupObject>EcoProIT.UI.App</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <!-- Modern replacements for WPFToolkit charting -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc4.5">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\box.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\buffer.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Facility.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="TextFile1.txt" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Machine.png" />
  </ItemGroup>
  <ItemGroup>
    <SplashScreen Include="Resources\LOGOTYPE.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\transport.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\trash.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chart\Chart.csproj" />
    <ProjectReference Include="..\DESEngine\DESEngine.csproj" />
    <ProjectReference Include="..\EcoProIT.DataLayer\EcoProIT.DataLayer.csproj" />
    <ProjectReference Include="..\EcoProIT.UserControles\EcoProIT.UserControles.csproj" />
    <ProjectReference Include="..\HelpClasses\HelpClasses.csproj" />
    <ProjectReference Include="..\IntelliBox\IntelliBox.csproj" />
  </ItemGroup>
  <ItemGroup>
    <BootstrapperPackage Include=".NETFramework,Version=v4.6">
      <Visible>False</Visible>
      <ProductName>Microsoft .NET Framework 4.6 %28x86 and x64%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Net.Framework.3.5.SP1">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5 SP1</ProductName>
      <Install>false</Install>
    </BootstrapperPackage>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\open.jpg" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\save.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\newproduct.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\runsimulation.png" />
  </ItemGroup>
  <ItemGroup>
    <FileAssociation Include=".ecos">
      <Visible>False</Visible>
      <Description>EcoProIT save File</Description>
      <Progid>ecoproit</Progid>
      <DefaultIcon>Resources\Icon.ico</DefaultIcon>
    </FileAssociation>
  </ItemGroup>
  <ItemGroup>
    <PublishFile Include="System.Data.SqlServerCe">
      <Visible>False</Visible>
      <Group>
      </Group>
      <TargetPath>
      </TargetPath>
      <PublishState>Exclude</PublishState>
      <IncludeHash>True</IncludeHash>
      <FileType>Assembly</FileType>
    </PublishFile>
  </ItemGroup>
</Project>